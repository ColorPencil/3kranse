# Server-side only. Never add a VITE_ prefix to credentials.
PORT=4173
SITE_URL=https://www.3kranse.com/
# Only set exact proxy socket addresses you control. Empty = trust no forwarded IP header.
TRUST_PROXY_IPS=
# Runtime D1 REST storage. Tokens and secrets never belong in VITE_*.
GUESTBOOK_STORAGE=d1
D1_ACCOUNT_ID=bff779ecc13e8c146a85cdd394aa1d04
D1_DATABASE_ID=e4fd2534-6f88-47c5-9292-e8ec26d31376
D1_API_TOKEN=
CAPTCHA_PROVIDER=turnstile
TURNSTILE_SITE_KEY=0x4AAAAAAFn7SK-yQBk5ZTrz
TURNSTILE_SECRET_KEY=
# Optional legacy backend: use GUESTBOOK_STORAGE=upstream and CAPTCHA_PROVIDER=image.
# Example: http://127.0.0.1:8080/ (IP:PORT supported)
GUESTBOOK_API_BASE_URL=
GUESTBOOK_API_TOKEN=
# Absolute, fixed upstream URLs, called by the server adapter only.
CAPTCHA_CHALLENGE_URL=
CAPTCHA_VERIFY_URL=
CAPTCHA_API_TOKEN=
