{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "3kranse",
  "main": "./cloudflare/pages-worker.mjs",
  "compatibility_date": "2026-10-13",
  // The existing edge handler is shared by Workers and Pages; static pages bypass it.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/guestbook/*", "/ko", "/ko/*"]
  }
}
