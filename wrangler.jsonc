{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "3kranse",
  "main": "./cloudflare/pages-worker.mjs",
  "compatibility_date": "2026-10-13",
  // Preserve runtime variables entered in the dashboard across Git-triggered deployments.
  "keep_vars": true,
  "vars": {
    "GUESTBOOK_STORAGE": "d1",
    "D1_ACCOUNT_ID": "bff779ecc13e8c146a85cdd394aa1d04",
    "D1_DATABASE_ID": "e4fd2534-6f88-47c5-9292-e8ec26d31376",
    "CAPTCHA_PROVIDER": "turnstile",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFn7SK-yQBk5ZTrz"
  },
  // The existing edge handler is shared by Workers and Pages; static pages bypass it.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/guestbook/*", "/ko", "/ko/*"]
  }
}
