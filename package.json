{
  "name": "three-kingdoms-official-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/compile-content.mjs && vite",
    "build": "node scripts/compile-content.mjs && vite build && node scripts/prepare-sites-build.mjs && vite build --ssr src/entry-server.jsx --outDir .render && node scripts/prerender.mjs",
    "start": "node server/serve.mjs",
    "test": "node --test tests/guestbook.test.mjs tests/public-data.test.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "check": "node scripts/check-build.mjs",
    "build:pages": "pnpm run build && node scripts/prepare-pages.mjs",
    "test:pages": "node --test tests/pages-worker.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "vite": "6.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=22"
  }
}
