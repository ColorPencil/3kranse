{
  "name": "three-kingdoms-official-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/compile-content.mjs && vite",
    "build": "node scripts/compile-content.mjs && vite build && node scripts/prepare-sites-build.mjs && vite build --ssr src/entry-server.jsx --outDir .render && node scripts/prerender.mjs",
    "start": "node server/serve.mjs",
    "test": "node --test tests/guestbook.test.mjs tests/public-data.test.mjs scripts/tests/locale.test.mjs scripts/tests/guestbook-d1.test.mjs scripts/tests/guestbook-privacy.test.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "check": "node scripts/check-build.mjs",
    "build:pages": "pnpm run build && node scripts/prepare-pages.mjs",
    "test:pages": "node --test tests/pages-worker.test.mjs",
    "build:workers": "pnpm run build && node scripts/prepare-workers.mjs",
    "deploy:workers": "wrangler deploy",
    "preview:workers": "wrangler dev --local",
    "test:locale": "node --test scripts/tests/locale.test.mjs",
    "test:d1": "node --test scripts/tests/guestbook-d1.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "wrangler": "4.153.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0"
}
